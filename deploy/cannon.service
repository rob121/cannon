[Unit]
Description=Cannon multisite CMS
Documentation=https://github.com/rob121/cannon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root. For a dedicated user instead:
#   useradd --system --home /opt --shell /usr/sbin/nologin cannon
#   chown -R cannon:cannon /opt/ranger-sites-data
# then set User=cannon and Group=cannon below.

Environment=CANNON_CONFIG=/etc/cannon/sites.json
WorkingDirectory=/opt

ExecStart=/usr/local/bin/cannon --port 8001
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Cover every writable path from sites.json (data_root, extensions, sockets, site DBs).
# Logs showed /opt/cannon/sockets — without it, ProtectSystem=strict blocks bind and extensions auto-disable.
ReadWritePaths=/opt/ranger-sites-data /opt/cannon /etc/cannon
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

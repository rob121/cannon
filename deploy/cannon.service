[Unit]
Description=Cannon multisite CMS
Documentation=https://github.com/rob121/cannon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root. For a dedicated user instead:
#   useradd --system --home /opt --shell /usr/sbin/nologin cannon
#   chown -R cannon:cannon /opt/ranger-sites-data
# then set User=cannon and Group=cannon below.

Environment=CANNON_CONFIG=/etc/cannon/sites.json
WorkingDirectory=/opt

# Binary install location; adjust if you keep the binary elsewhere.
# Self-update stages siblings beside this path: cannon.latest and cannon.previous.
ExecStart=/usr/local/bin/cannon --port 8001
ExecReload=/bin/kill -HUP $MAINPID

# always: required so admin Apply/Rollback can exit(0) and systemd brings Cannon back.
# on-failure would leave the service stopped after a successful staged update.
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Cover every writable path from sites.json (data_root, extensions, sockets, site DBs)
# plus the binary directory so cannon.latest / cannon.previous can be written.
ReadWritePaths=/opt/ranger-sites-data /opt/cannon /etc/cannon /usr/local/bin
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
